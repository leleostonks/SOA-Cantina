{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leleostonks/SOA-Cantina/contratos/pedido-confirmado.json",
  "title": "cantina.pedido.confirmado",
  "description": "Evento publicado pelo Pedidos quando um pedido é confirmado, no envelope CloudEvents 1.0 (modo estruturado, Content-Type application/cloudevents+json). Quem publica não espera resposta e não conhece os consumidores. Na Trilha A, o Pedidos faz POST deste JSON em cada endereço da variável ASSINANTES; na Trilha B, publica o mesmo JSON no broker.",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "time", "datacontenttype", "subject", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Único por evento. O consumidor usa para ignorar entregas repetidas."
    },
    "source": {
      "const": "/cantina/pedidos",
      "description": "Quem produziu o evento."
    },
    "type": { "const": "cantina.pedido.confirmado" },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "const": "application/json" },
    "subject": {
      "type": "string",
      "description": "id do pedido, como texto."
    },
    "data": {
      "type": "object",
      "required": ["pedidoId", "alunoId", "totalCentavos", "itens"],
      "properties": {
        "pedidoId": { "type": "integer", "minimum": 1 },
        "alunoId": { "type": "string", "minLength": 1 },
        "totalCentavos": { "type": "integer", "minimum": 0 },
        "itens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["itemId", "nome", "quantidade"],
            "properties": {
              "itemId": { "type": "integer", "minimum": 1 },
              "nome": { "type": "string" },
              "quantidade": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "specversion": "1.0",
      "id": "6f1c2a9e-3b7d-4e1a-9c2f-0a8b5d4e3f21",
      "source": "/cantina/pedidos",
      "type": "cantina.pedido.confirmado",
      "time": "2026-10-19T10:15:00Z",
      "datacontenttype": "application/json",
      "subject": "7",
      "data": {
        "pedidoId": 7,
        "alunoId": "RM98765",
        "totalCentavos": 2500,
        "itens": [
          { "itemId": 1, "nome": "Coxinha", "quantidade": 2 },
          { "itemId": 2, "nome": "Suco de laranja", "quantidade": 1 }
        ]
      }
    }
  ]
}
